// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================================================================
// Enums
// ==================================================================

enum AuthRole {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum DocumentType {
  LOGO
  BANNER
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  OTHER
}

enum OrganizationRole {
  OWNER
  STORE_MANAGER
  ACCOUNTANT
}

enum StoreIndustry {
  RESTAURANT
  CAFE
  BAR
  HOTEL
  SALON
  SPA
  RETAIL
  BARBERSHOP
  FITNESS
  FOOD_TRUCK
  CLEANING
  OTHER
}

enum Language {
  EN
  EL
  ES
  FR
  DE
  IT
  PT
  TR
  RU
  AR
  ZH
}

// Mirrors the Language markets above: EUR (eurozone), USD/GBP (English),
// TRY (Turkey), RUB (Russia), AED (Arabic-market default), CNY (China).
enum Currency {
  EUR
  USD
  GBP
  TRY
  RUB
  AED
  CNY
}

enum QrCodeSelectionMode {
  CHOOSE_ONE
  CHOOSE_MANY
  TEAM
}

enum DistributionRecipientType {
  STORE
  EMPLOYEE
}

enum TipStatus {
  PENDING // deprecated in favor of CREATED; kept for backward compatibility with existing rows
  CREATED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentTransactionStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PayoutStatus {
  PENDING
  PROCESSING // claimed by an in-flight Payout run, awaiting the bank-transfer result
  PAID
  FAILED
  CANCELLED // the parent Tip was refunded before this share was ever paid out
}

enum PayoutExecutionStatus {
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// Connected-account lifecycle with the payment processor (e.g. Stripe
// Connect onboarding), not to be confused with PayoutStatus above, which
// tracks a single payout transaction.
enum PayoutAccountStatus {
  PENDING
  ACTIVE
  RESTRICTED
  DISABLED
}

enum PayoutAccountOwnerType {
  STORE
  USER
}

enum PayoutMethod {
  IBAN
  CONNECTED_ACCOUNT // reserved for a future Marketplace-connected-account upgrade; not built in this phase
}

enum PaymentProvider {
  VIVA
  STRIPE
  PAYPAL
}

enum ReviewSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum FeedbackQuestionType {
  RATING
  TEXT
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum AlertType {
  POSITIVE_COMPLIMENTS
  NEGATIVE_SATISFACTION_DROP
  LOW_RATING_REVIEW
  PERFORMANCE_CHANGE
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// ==================================================================
// Identity — User: a real person identified by email.
// Every Account type below (OrganizationMember, Employee, customer
// activity on Tip/Review) links back to a User. A User row can exist
// as a passwordless shell before the person ever registers.
// ==================================================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  phone             String?   @unique
  first_name        String? // unset until the person registers or is otherwise captured (e.g. a Store adding them as staff by name)
  last_name         String?
  password          String? // null until the person sets a password; until then this row is a passive shell, not a login
  role              AuthRole  @default(USER) // platform-level role (support/admin); unrelated to OrganizationRole, which is per Organization
  registered_at     DateTime? // set the moment the person claims this identity by setting a password for the first time
  is_email_verified Boolean   @default(false)
  is_phone_verified Boolean   @default(false)
  is_archived       Boolean   @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  password_reset_tokens    PasswordResetToken[]
  documents                Document[]
  organization_memberships OrganizationMember[]
  employee_accounts        Employee[]
  customer_tips            Tip[]                @relation("TipCustomer")
  customer_reviews         Review[]             @relation("ReviewCustomer")
  refunds_requested        Refund[]             @relation("RefundRequestedBy")
  refunds_processed        Refund[]             @relation("RefundProcessedBy")
  payout_account           PayoutAccount?

  @@index([email])
  @@index([phone])
  @@map("users")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  token_hash String    @unique
  user_uuid  String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_uuid], references: [id], onDelete: Cascade)

  @@index([user_uuid])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

model Document {
  id         String       @id @default(uuid())
  user_uuid  String
  filename   String
  mimetype   String
  size       Int
  url        String
  path       String
  type       DocumentType @default(LOGO)
  created_at DateTime     @default(now())

  user User @relation(fields: [user_uuid], references: [id], onDelete: Cascade)

  stores_logo        Store[]        @relation("StoreLogoDocument")
  stores_cover       Store[]        @relation("StoreCoverDocument")
  organizations_logo Organization[] @relation("OrganizationLogoDocument")
  employees_photo    Employee[]     @relation("EmployeePhotoDocument")

  @@index([user_uuid])
  @@map("documents")
}

// ==================================================================
// Organizations & Stores
// ==================================================================

model Organization {
  id               String  @id @default(uuid())
  name             String
  slug             String  @unique
  is_active        Boolean @default(true)
  logo_document_id String?
  vat_number       String? // billing identity for invoicing — set via org settings, never inferred
  legal_name       String? // registered legal entity name, may differ from the customer-facing `name`
  profession       String? // declared business activity, shown on invoices (e.g. "Restaurant", "Καφετέρια")
  doy              String? // Greek tax office (Δ.Ο.Υ.) — only relevant for Greek-registered organizations

  // Registered billing address — the invoice-recipient address, independent
  // of any Store's own (possibly different/multiple) physical address(es).
  address_line String?
  city         String?
  country      String?
  postal_code  String?
  full_address Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  logo_document Document? @relation("OrganizationLogoDocument", fields: [logo_document_id], references: [id], onDelete: SetNull)

  members      OrganizationMember[]
  stores       Store[]
  subscription Subscription?

  @@index([slug])
  @@map("organizations")
}

// Organization Account: membership + role, scoped either at
// the Organization level (store_id null) or a single Store (store_id set).
model OrganizationMember {
  id              String           @id @default(uuid())
  organization_id String
  user_id         String
  role            OrganizationRole
  store_id        String? // null = scoped to the whole Organization; set = scoped to just this one Store
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  store        Store?       @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, user_id, store_id, role])
  @@index([organization_id])
  @@index([user_id])
  @@index([store_id])
  @@map("organization_members")
}

// Billing: one subscription per Organization, covering every Store under it.
model Subscription {
  id                               String             @id @default(uuid())
  organization_id                  String             @unique
  plan                             SubscriptionPlan   @default(STARTER)
  status                           SubscriptionStatus @default(TRIALING)
  billing_provider_customer_id     String?
  billing_provider_subscription_id String?
  current_period_start             DateTime?
  current_period_end               DateTime?
  created_at                       DateTime           @default(now())
  updated_at                       DateTime           @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// A Store: fully self-contained — branding, employees, QR codes,
// tipping/review config, tips, reviews, analytics.
model Store {
  id              String        @id @default(uuid())
  organization_id String
  name            String
  slug            String        @unique
  industry        StoreIndustry @default(OTHER)
  is_active       Boolean       @default(true)

  // Branding
  logo_document_id  String?
  cover_document_id String?
  primary_color     String?
  secondary_color   String?

  // Customer-facing messages (§23, §24). Json map of lowercase Language
  // code -> text, e.g. {"en": "Welcome!", "el": "Καλώς ήρθατε!"}; the
  // primary_language key is always present, others are filled in as
  // translations are produced.
  welcome_message   Json?
  thank_you_message Json?

  // Address
  full_address Json?
  address_line String?
  city         String?
  country      String?
  postal_code  String?
  timezone     String  @default("UTC")

  // Localization
  primary_language    Language   @default(EN)
  supported_languages Language[] @default([EN])

  // Tipping configuration
  currency                Currency @default(EUR)
  suggested_tip_amounts   Int[]    @default([200, 1000, 2000, 5000])
  allow_custom_tip_amount Boolean  @default(true)

  // % of VAT added on top of the tip amount at checkout time. No default —
  // must be set explicitly per store; null/0 means no VAT is charged on tips
  // at this store (never auto-applies Greece's 24% or any other rate).
  vat_rate_percentage Decimal? @db.Decimal(5, 2)

  // Review flow routing: above the threshold, prompt the customer to post
  // a public review; below it, collect private feedback instead.
  public_review_redirect_url     String?
  public_review_rating_threshold Int?    @default(4)

  // The rule applied when a tip doesn't come through a QR code with its own override.
  // @unique because a rule can only ever be the default for the one store it belongs to.
  default_distribution_rule_id String? @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization              Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  logo_document             Document?         @relation("StoreLogoDocument", fields: [logo_document_id], references: [id], onDelete: SetNull)
  cover_document            Document?         @relation("StoreCoverDocument", fields: [cover_document_id], references: [id], onDelete: SetNull)
  default_distribution_rule DistributionRule? @relation("StoreDefaultDistributionRule", fields: [default_distribution_rule_id], references: [id], onDelete: SetNull)

  organization_members OrganizationMember[]
  employees            Employee[]
  spots                Spot[]
  qr_codes             QrCode[]
  distribution_rules   DistributionRule[]   @relation("StoreDistributionRules")
  tips                 Tip[]
  reviews              Review[]
  review_categories    ReviewCategory[]
  review_tags          ReviewTag[]
  feedback_questions   FeedbackQuestion[]
  alert_preferences    AlertPreference[]
  alerts               Alert[]
  insight_summaries    InsightSummary[]
  payout_account       PayoutAccount?
  payouts              Payout[]

  @@index([organization_id])
  @@index([slug])
  @@map("stores")
}

// ==================================================================
// Employees — the Employee Account.
// ==================================================================

model Employee {
  id                String    @id @default(uuid())
  store_id          String
  user_id           String?
  // Multilingual: Json map of lowercase Language code -> text, e.g.
  // {"en": "Maria Papadopoulou", "el": "Μαρία Παπαδοπούλου"}. Auto-translated
  // (stub) into every Store-supported language on create; hand-edited per
  // language via full_name_translations on PATCH employees/:id.
  full_name         Json
  email             String
  photo_document_id String?
  position          String?
  is_active         Boolean   @default(true)
  invited_at        DateTime? // last time an account-setup invite email was sent to this Employee's User
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  store          Store     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user           User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  photo_document Document? @relation("EmployeePhotoDocument", fields: [photo_document_id], references: [id], onDelete: SetNull)

  qr_codes                     QrCodeEmployee[]
  distribution_rule_recipients DistributionRuleRecipient[]
  tips                         Tip[]
  tip_distributions            TipDistribution[]
  reviews                      Review[]
  alerts                       Alert[]
  payouts                      Payout[]

  @@index([store_id])
  @@index([user_id])
  @@index([email])
  @@map("employees")
}

// ==================================================================
// Spots — a Store's physical placements (a restaurant table, a spa bed,
// a salon chair, a hotel room, the bar, reception, a checkout counter,
// ...). Optional and many-to-many with QrCode: a QR can cover several
// spots (e.g. one code printed for a whole patio zone) and a spot can
// have several QR codes (e.g. one on the table, one on the receipt) or
// none at all (a QR meant for an employee card or promotional material
// has no spot).
// ==================================================================

model Spot {
  id         String   @id @default(uuid())
  store_id   String
  name       String // e.g. "Table 12", "Bed 3", "Room 204", "Bar", "Reception"
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  qr_codes QrCodeSpot[]

  @@index([store_id])
  @@map("spots")
}

// ==================================================================
// QR Codes
// ==================================================================

model QrCode {
  id                   String              @id @default(uuid())
  store_id             String
  code                 String              @unique // short code embedded in the scan URL, e.g. delitip.com/{store_slug}/q/{code}
  label                String
  // Only meaningful when 2+ employees are assigned below; ignored for 0 or 1.
  // CHOOSE_ONE: customer picks exactly one to thank. CHOOSE_MANY: customer
  // picks any subset; the tip splits only among those picked, the rule's
  // percentages renormalized across just the selected employees. TEAM: no
  // selection step, tip is split across all of them automatically.
  selection_mode       QrCodeSelectionMode @default(CHOOSE_ONE)
  is_active            Boolean             @default(true)
  distribution_rule_id String? // override for this QR code only; null falls back to the store's default rule
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt

  store             Store             @relation(fields: [store_id], references: [id], onDelete: Cascade)
  distribution_rule DistributionRule? @relation(fields: [distribution_rule_id], references: [id], onDelete: SetNull)

  // Both optional and independent of each other: a QR can carry any number
  // of spots and any number of employees. A QR with employees but no
  // spots is effectively a portable/personal QR (e.g. an employee's own
  // business card); a QR with spots is a location QR.
  spots     QrCodeSpot[]
  employees QrCodeEmployee[]
  tips      Tip[]

  @@index([store_id])
  @@index([code])
  @@index([distribution_rule_id])
  @@map("qr_codes")
}

// Join table: which spot(s) a QR code is placed at, if any.
model QrCodeSpot {
  id         String   @id @default(uuid())
  qr_code_id String
  spot_id    String
  created_at DateTime @default(now())

  qr_code QrCode @relation(fields: [qr_code_id], references: [id], onDelete: Cascade)
  spot    Spot   @relation(fields: [spot_id], references: [id], onDelete: Cascade)

  @@unique([qr_code_id, spot_id])
  @@index([qr_code_id])
  @@index([spot_id])
  @@map("qr_code_spots")
}

// Join table: which employee(s) a QR code can attribute a tip to.
model QrCodeEmployee {
  id          String   @id @default(uuid())
  qr_code_id  String
  employee_id String
  created_at  DateTime @default(now())

  qr_code  QrCode   @relation(fields: [qr_code_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([qr_code_id, employee_id])
  @@index([qr_code_id])
  @@index([employee_id])
  @@map("qr_code_employees")
}

// ==================================================================
// Distribution Rules — how a tip is split between the Store and/or Employees.
// ==================================================================

model DistributionRule {
  id         String   @id @default(uuid())
  store_id   String
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  store Store @relation("StoreDistributionRules", fields: [store_id], references: [id], onDelete: Cascade)

  recipients        DistributionRuleRecipient[]
  default_for_store Store?                      @relation("StoreDefaultDistributionRule")
  qr_code_overrides QrCode[]
  tips              Tip[]

  @@unique([store_id, name])
  @@index([store_id])
  @@map("distribution_rules")
}

// One line item of a Distribution Rule: a recipient (Store or a specific
// Employee) and its share. A rule's recipients' percentages sum to 100.
model DistributionRuleRecipient {
  id                   String                    @id @default(uuid())
  distribution_rule_id String
  recipient_type       DistributionRecipientType
  employee_id          String? // required when recipient_type is EMPLOYEE, null when recipient_type is STORE
  percentage           Decimal                   @db.Decimal(5, 2) // 0-100; all recipients on a rule must sum to 100
  sort_order           Int                       @default(0) // display order; the lowest sort_order recipient absorbs the rounding remainder on a split (§5)
  created_at           DateTime                  @default(now())

  distribution_rule DistributionRule @relation(fields: [distribution_rule_id], references: [id], onDelete: Cascade)
  employee          Employee?        @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([distribution_rule_id])
  @@index([employee_id])
  @@map("distribution_rule_recipients")
}

// ==================================================================
// Tips & Payouts
// ==================================================================

// Payout destination at a payment processor. Owned by either a Store
// (where it collects tips itself) or a User (a person's own connected
// account, shared across every Employee Account they hold — see §11 —
// since the processor ties one connected account to one person's
// identity/KYC, not to a specific employment at one Store). Exactly one
// of store_id/user_id is set, matching owner_type; the unique constraint
// on each caps it at one payout account per owner.
model PayoutAccount {
  id                   String                 @id @default(uuid())
  owner_type           PayoutAccountOwnerType
  store_id             String?                @unique // set when owner_type is STORE
  user_id              String?                @unique // set when owner_type is USER
  provider             PaymentProvider        @default(VIVA)
  provider_account_id  String // the connected account id with that processor
  status               PayoutAccountStatus    @default(PENDING)
  payout_method        PayoutMethod           @default(IBAN)
  bank_account_id      String? // Viva's linked-bank-account id from the Bank Transfer API
  iban_last4           String? // last 4 digits only — the raw IBAN is never persisted, see §16 of the payment plan
  beneficiary_name     String?
  connected_account_id String? // the provider's connected/seller account id (Viva Marketplace today; a future Stripe Connect account reuses this same generic column)
  onboarding_url       String? // hosted-onboarding link shown to the owner until the connected account finishes verification
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  store   Store?   @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payouts Payout[]

  @@map("payout_accounts")
}

model Tip {
  id                    String           @id @default(uuid())
  store_id              String
  qr_code_id            String
  employee_id           String? // the single employee this tip was attributed to (one-employee QR or a Choose-one pick); null for store-only tips and Team-mode tips, which are split across `distributions` instead
  distribution_rule_id  String? // the rule applied at the time of this tip; `distributions` holds the actual frozen amounts, so later edits to the rule can't retroactively change this tip
  selected_employee_ids Json? // resolved at checkout time (Choose-many/Team); `distributions` aren't created until payment is confirmed, so this is what the webhook handler feeds into calculateTipDistribution()
  customer_user_id      String? // customers are never required to identify themselves — these three fields stay null for anonymous tips
  customer_email        String?
  customer_name         String?
  amount                Int // in the smallest currency unit (e.g. cents)
  currency              Currency         @default(EUR)
  status                TipStatus        @default(CREATED) // payment lifecycle of the tip itself, separate from payout_status on each TipDistribution
  payment_provider      PaymentProvider? @default(VIVA)
  payment_reference     String?
  paid_at               DateTime?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  store             Store             @relation(fields: [store_id], references: [id])
  qr_code           QrCode            @relation(fields: [qr_code_id], references: [id])
  employee          Employee?         @relation(fields: [employee_id], references: [id], onDelete: SetNull)
  distribution_rule DistributionRule? @relation(fields: [distribution_rule_id], references: [id], onDelete: SetNull)
  customer          User?             @relation("TipCustomer", fields: [customer_user_id], references: [id], onDelete: SetNull)

  distributions       TipDistribution[]
  review              Review?
  refunds             Refund[]
  payment_transaction PaymentTransaction?

  @@index([store_id])
  @@index([qr_code_id])
  @@index([employee_id])
  @@index([customer_user_id])
  @@index([status])
  @@index([created_at])
  @@index([status, created_at])
  @@map("tips")
}

// The real-money ledger row for a Tip: gross amount, provider order/transaction
// references, and the fee/commission breakdown. 1:1 with Tip — created the
// moment a checkout order is opened with the processor, finalized once the payment
// webhook (or the reconciliation sweep) confirms the transaction.
model PaymentTransaction {
  id                             String                   @id @default(uuid())
  tip_id                         String                   @unique
  provider                       PaymentProvider          @default(VIVA)
  client_request_id              String?                  @unique // idempotency key supplied by the frontend on POST /public/tips
  provider_order_code            String?                  @unique // string, never numeric — Viva's 16-digit orderCode exceeds Number.MAX_SAFE_INTEGER
  provider_transaction_id        String?                  @unique
  tip_amount                     Int // the net, VAT-exclusive amount the customer selected — base for commission_amount and net_distributable_amount
  vat_rate_percentage            Decimal?                 @db.Decimal(5, 2) // snapshotted from Store.vat_rate_percentage at creation time — never recomputed from live store config later
  vat_amount                     Int? // round(tip_amount * vat_rate_percentage / 100) — retained by the platform in full, never distributed to store/employee
  gross_amount                   Int // tip_amount + vat_amount — the VAT-inclusive total actually charged via Viva
  currency                       Currency
  commission_percentage_used     Decimal                  @db.Decimal(5, 2) // snapshotted from PlatformFinanceConfig at creation time — never recomputed from live config later
  commission_amount              Int
  platform_fee_percentage        Decimal                  @db.Decimal(5, 2) // commission_amount / tip_amount — the actual realized rate, distinct from the configured commission_percentage_used above (rounding can make them differ)
  processor_fee_percentage_used  Decimal?                 @db.Decimal(5, 2) // snapshotted from PlatformFinanceConfig when processor_fee_estimated was computed — the processor-fee mirror of commission_percentage_used above; never recomputed from live config later, and stays unset for tips that never reached that step
  processor_fee_estimated        Int?
  processor_fee_confirmed_amount Int?
  processor_fee_confirmed        Boolean                  @default(false) // gates payout eligibility — a payout can never be computed from an estimate
  payment_fee_percentage         Decimal?                 @db.Decimal(5, 2) // processor fee / gross_amount (VAT-inclusive — Viva's fee is charged on the full amount it processes), using whichever of the two fields above is current
  total_fee_amount               Int? // commission_amount + processor fee (estimated until processor_fee_confirmed, then confirmed) — does NOT include vat_amount, which is tracked and retained separately
  total_fee_percentage           Decimal?                 @db.Decimal(5, 2) // total_fee_amount / gross_amount
  total_fee_percentage_sum       Decimal?                 @db.Decimal(5, 2) // platform_fee_percentage + payment_fee_percentage — the two rates added directly, kept alongside total_fee_percentage as a cross-check since per-fee rounding can make them differ slightly
  net_distributable_amount       Int? // tip_amount - total_fee_amount — what's actually split via distribution rules to store/employee; vat_amount never enters this pool
  payment_method                 String?
  status                         PaymentTransactionStatus @default(CREATED)
  failure_reason                 String?
  confirmed_at                   DateTime?
  created_at                     DateTime                 @default(now())
  updated_at                     DateTime                 @updatedAt

  tip Tip @relation(fields: [tip_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([provider])
  @@map("payment_transactions")
}

// Idempotency + audit log for every inbound Viva webhook. message_id is
// Viva's own MessageId — the unique constraint is what makes at-least-once
// delivery (Viva retries up to 24x hourly) safe to process.
model WebhookEvent {
  id               String          @id @default(uuid())
  provider         PaymentProvider @default(VIVA)
  message_id       String          @unique
  event_type_id    Int
  payload          Json
  processed_at     DateTime?
  processing_error String?
  created_at       DateTime        @default(now())

  @@index([event_type_id])
  @@map("webhook_events")
}

// The frozen, per-recipient breakdown of a Tip at the moment it was paid —
// so later changes to a Distribution Rule never affect past tips, and
// each recipient's payout can be tracked independently.
model TipDistribution {
  id             String                    @id @default(uuid())
  tip_id         String
  recipient_type DistributionRecipientType
  employee_id    String? // required when recipient_type is EMPLOYEE, null when recipient_type is STORE
  amount         Int // this recipient's frozen share of the tip, in the smallest currency unit (rounding remainder goes to the first-listed recipient)
  percentage     Decimal                   @db.Decimal(5, 2) // the rule's percentage at the time this tip was made
  payout_status  PayoutStatus              @default(PENDING) // whether this recipient's share has actually been paid out — independent of the Tip's own status
  payout_id      String? // set only inside the atomic claim of a Payout run; null while PENDING/unclaimed
  paid_out_at    DateTime?
  created_at     DateTime                  @default(now())

  tip      Tip       @relation(fields: [tip_id], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)
  payout   Payout?   @relation(fields: [payout_id], references: [id], onDelete: SetNull)

  @@index([tip_id])
  @@index([employee_id])
  @@index([payout_status])
  @@index([payout_id])
  @@map("tip_distributions")
}

// One Bank Transfer API execution to one recipient (Store or Employee),
// covering one or more TipDistribution rows accumulated since the last
// payout for that recipient. Created only by a manual "Pay out now" run
// (§10 of the payment plan) — there is no scheduled batch job in this phase.
model Payout {
  id                   String                    @id @default(uuid())
  recipient_type       DistributionRecipientType
  store_id             String?
  employee_id          String?
  payout_account_id    String
  amount               Int
  currency             Currency
  provider             PaymentProvider           @default(VIVA)
  provider_transfer_id String? // Viva bank-transfer commandId
  status               PayoutExecutionStatus     @default(PROCESSING)
  failure_reason       String?
  executed_at          DateTime?
  created_at           DateTime                  @default(now())
  updated_at           DateTime                  @updatedAt

  store          Store?            @relation(fields: [store_id], references: [id])
  employee       Employee?         @relation(fields: [employee_id], references: [id])
  payout_account PayoutAccount     @relation(fields: [payout_account_id], references: [id])
  distributions  TipDistribution[]

  @@index([status])
  @@index([store_id])
  @@index([employee_id])
  @@map("payouts")
}

model Refund {
  id                             String       @id @default(uuid())
  tip_id                         String
  amount                         Int
  reason                         String?
  status                         RefundStatus @default(PENDING)
  requested_by_user_id           String? // who asked for the refund — often the customer, sometimes a store manager acting for them
  processed_by_user_id           String? // who approved/executed it, e.g. a Store Manager or Accountant
  provider_reference             String? // Viva's transactionId for the refund/fast-refund/rebate call
  provider_status                String? // Viva's own status for that reference, finalized once the 1797 webhook confirms
  requires_manual_reconciliation Boolean      @default(false) // set when a refund was approved on a tip whose distributions were already paid out — IBAN transfers have no automatic clawback
  created_at                     DateTime     @default(now())
  updated_at                     DateTime     @updatedAt

  tip          Tip   @relation(fields: [tip_id], references: [id], onDelete: Cascade)
  requested_by User? @relation("RefundRequestedBy", fields: [requested_by_user_id], references: [id], onDelete: SetNull)
  processed_by User? @relation("RefundProcessedBy", fields: [processed_by_user_id], references: [id], onDelete: SetNull)

  @@index([tip_id])
  @@index([status])
  @@map("refunds")
}

// ==================================================================
// Reviews & Feedback
// ==================================================================

model Review {
  id                            String           @id @default(uuid())
  store_id                      String
  tip_id                        String?          @unique // the tip this review followed, if any — a review doesn't strictly require a tip
  employee_id                   String?
  customer_user_id              String?
  customer_email                String?
  customer_name                 String?
  rating                        Int
  comment                       String?
  sentiment                     ReviewSentiment? // auto-categorized from the rating/comment; null until that analysis has run
  redirected_to_public_platform Boolean          @default(false) // whether the customer was sent on to the store's public review platform after this review
  created_at                    DateTime         @default(now())
  updated_at                    DateTime         @updatedAt

  store    Store     @relation(fields: [store_id], references: [id])
  tip      Tip?      @relation(fields: [tip_id], references: [id], onDelete: SetNull)
  employee Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)
  customer User?     @relation("ReviewCustomer", fields: [customer_user_id], references: [id], onDelete: SetNull)

  category_ratings   ReviewCategoryRating[]
  feedback_responses FeedbackResponse[]
  tags               ReviewTagAssignment[]

  @@index([store_id])
  @@index([employee_id])
  @@index([customer_user_id])
  @@index([rating])
  @@index([created_at])
  @@map("reviews")
}

// Store-configurable rating categories, e.g. Friendliness, Speed, Professionalism.
model ReviewCategory {
  id         String   @id @default(uuid())
  store_id   String
  name       Json // §24: language code -> text, e.g. {"en": "Friendliness", "el": "Φιλικότητα"}
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  store   Store                  @relation(fields: [store_id], references: [id], onDelete: Cascade)
  ratings ReviewCategoryRating[]

  @@index([store_id])
  @@map("review_categories")
}

model ReviewCategoryRating {
  id                 String   @id @default(uuid())
  review_id          String
  review_category_id String
  rating             Int
  created_at         DateTime @default(now())

  review          Review         @relation(fields: [review_id], references: [id], onDelete: Cascade)
  review_category ReviewCategory @relation(fields: [review_category_id], references: [id], onDelete: Cascade)

  @@unique([review_id, review_category_id])
  @@index([review_id])
  @@index([review_category_id])
  @@map("review_category_ratings")
}

// Store-scoped topic tags used to auto-categorize review content (§19/§20),
// e.g. "Friendly service", "Slow service", "Waiting time". Distinct from
// ReviewCategory (a star-rating question the customer answers): a tag is
// applied afterward, by the store or by AI analysis, to summarize what a
// review was actually about.
model ReviewTag {
  id         String           @id @default(uuid())
  store_id   String
  name       String
  sentiment  ReviewSentiment? // which bucket this tag falls under (§19: Positive / Negative); null if unbucketed
  is_active  Boolean          @default(true)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  store   Store                 @relation(fields: [store_id], references: [id], onDelete: Cascade)
  reviews ReviewTagAssignment[]

  @@unique([store_id, name])
  @@index([store_id])
  @@map("review_tags")
}

model ReviewTagAssignment {
  id            String   @id @default(uuid())
  review_id     String
  review_tag_id String
  created_at    DateTime @default(now())

  review     Review    @relation(fields: [review_id], references: [id], onDelete: Cascade)
  review_tag ReviewTag @relation(fields: [review_tag_id], references: [id], onDelete: Cascade)

  @@unique([review_id, review_tag_id])
  @@index([review_id])
  @@index([review_tag_id])
  @@map("review_tag_assignments")
}

// Store-configurable feedback questions, e.g. "How was the food?".
model FeedbackQuestion {
  id         String               @id @default(uuid())
  store_id   String
  question   Json // §24: language code -> text, e.g. {"en": "How was the food?", "el": "..."}
  type       FeedbackQuestionType @default(RATING)
  is_active  Boolean              @default(true)
  sort_order Int                  @default(0)
  created_at DateTime             @default(now())
  updated_at DateTime             @updatedAt

  store     Store              @relation(fields: [store_id], references: [id], onDelete: Cascade)
  responses FeedbackResponse[]

  @@index([store_id])
  @@map("feedback_questions")
}

model FeedbackResponse {
  id                   String   @id @default(uuid())
  feedback_question_id String
  review_id            String
  // Exactly one of these is populated, matching the parent FeedbackQuestion's type: RATING → rating_value, TEXT → text_value.
  rating_value         Int?
  text_value           String?
  created_at           DateTime @default(now())

  feedback_question FeedbackQuestion @relation(fields: [feedback_question_id], references: [id], onDelete: Cascade)
  review            Review           @relation(fields: [review_id], references: [id], onDelete: Cascade)

  @@index([feedback_question_id])
  @@index([review_id])
  @@map("feedback_responses")
}

// ==================================================================
// Alerts
// ==================================================================

model AlertPreference {
  id         String    @id @default(uuid())
  store_id   String
  alert_type AlertType
  is_enabled Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@unique([store_id, alert_type])
  @@index([store_id])
  @@map("alert_preferences")
}

// A single triggered alert instance, generated for a Store when one of its enabled AlertPreferences fires.
model Alert {
  id          String    @id @default(uuid())
  store_id    String
  type        AlertType
  title       String
  message     String
  employee_id String?
  is_read     Boolean   @default(false)
  created_at  DateTime  @default(now())

  store    Store     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)

  @@index([store_id])
  @@index([employee_id])
  @@map("alerts")
}

// ==================================================================
// AI Feedback Analysis — periodic auto-generated summaries of
// customer feedback for a Store.
// ==================================================================

model InsightSummary {
  id                          String   @id @default(uuid())
  store_id                    String
  period_start                DateTime
  period_end                  DateTime
  summary                     String
  satisfaction_change_percent Decimal? @db.Decimal(5, 2)
  top_praise                  String?
  top_complaint               String?
  created_at                  DateTime @default(now())

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id])
  @@index([period_start, period_end])
  @@map("insight_summaries")
}
