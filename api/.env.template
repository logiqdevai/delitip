# ENVIRONMENT
NODE_ENV=staging

# CLIENT_URLS
APP_URL=http://localhost:5173
LANDING_URL=http://localhost:5173
API_URL=http://localhost:3000/api

# POSTGRES
DATABASE_URL=

# REDIS
REDIS_URL=
CACHE_TTL_SECONDS=

# JWT
JWT_SECRET=supersecret
JWT_EXPIRATION_TIME=30d

# RESEND
RESEND_API_KEY=

# TWILLIO
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# GOOGLE
GOOGLE_MAPS_API_KEY=

# GOOGLE STORAGE
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_CREDENTIALS_JSON_BASE64=

# STRIPE
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# VIVA
VIVA_ENVIRONMENT=demo
# Smart Checkout permission group — collecting tips
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
# Account Transactions permission group — IBAN linking + Bank Transfer payouts.
# Viva issues this as a SEPARATE OAuth2 client from Smart Checkout above; if
# left blank, Bank Transfer calls fall back to the Smart Checkout client and
# will likely be rejected as unauthorized for that permission group.
VIVA_ACCOUNT_TRANSACTIONS_CLIENT_ID=
VIVA_ACCOUNT_TRANSACTIONS_CLIENT_SECRET=
# Platform/Marketplace permission group — connected-account (Store) payouts.
# Requires a Viva Sales conversation to provision, even in the sandbox — see
# docs/VIVA_MARKETPLACE_MIGRATION_RESEARCH.md. Leave blank (and
# CONNECTED_ACCOUNT_PAYOUTS_ENABLED unset/false) until that access exists.
VIVA_PLATFORM_CLIENT_ID=
VIVA_PLATFORM_CLIENT_SECRET=
# Shown on Viva's hosted connected-account onboarding page. Both default from
# APP_URL if left blank (see VivaConfig.getMarketplacePartnerName/LogoUrl).
VIVA_MARKETPLACE_PARTNER_NAME=
VIVA_MARKETPLACE_LOGO_URL=
VIVA_MERCHANT_ID=
VIVA_API_KEY=
VIVA_SOURCE_CODE=
VIVA_WALLET_ID=
# Comma-separated. From https://developer.viva.com/webhooks-for-payments/
# "Whitelist the Viva addresses" — use the matching list for VIVA_ENVIRONMENT:
#   Demo:       20.50.240.57,40.74.20.78,195.167.87.181,195.167.87.180,20.13.195.185,135.225.16.50
#   Production: 51.138.37.238,40.127.253.112/28,51.105.129.192/28,20.54.89.16,4.223.76.50,51.12.157.0/28
VIVA_WEBHOOK_IP_ALLOWLIST=

# PLATFORM FINANCE
TIP_PLATFORM_COMMISSION_PERCENTAGE=5
TIP_PROCESSOR_FEE_ESTIMATE_PERCENTAGE=2.4
TIP_PROCESSOR_FEE_ESTIMATE_FIXED_AMOUNT=24
PAYOUT_HOLD_WINDOW_HOURS=48
# Central rollout switch for connected-account (Marketplace) Store payouts —
# keep false until VIVA_PLATFORM_CLIENT_ID/SECRET are real and a sandbox
# onboarding has been verified end-to-end.
CONNECTED_ACCOUNT_PAYOUTS_ENABLED=false

# AI
OPENAI_API_KEY=


# BULLMQ
BULL_BOARD_USER=petros
BULL_BOARD_PASSWORD=petros123

