import { BadRequestException } from '@nestjs/common';
import { createHash } from 'crypto';
import * as bcrypt from 'bcrypt';
import { EmailConfig } from '@/shared/constants/email';
import { AppUrls } from '@/shared/config/app-urls';
import { PasswordService } from './password.service';

jest.mock('bcrypt');
jest.mock('crypto', () => ({
    ...jest.requireActual('crypto'),
    randomBytes: jest.fn(),
}));

const { randomBytes } = jest.requireMock('crypto') as { randomBytes: jest.Mock };

const hashToken = (token: string) => createHash('sha256').update(token).digest('hex');
const flush = () => new Promise((resolve) => setImmediate(resolve));

describe('PasswordService', () => {
    let service: PasswordService;
    let prisma: any;
    let mailService: any;

    const NOW = new Date('2026-01-01T00:00:00.000Z');

    beforeEach(() => {
        jest.clearAllMocks();
        jest.useFakeTimers().setSystemTime(NOW);
        randomBytes.mockReturnValue(Buffer.alloc(32, 1)); // deterministic 64-char hex token
        prisma = {
            user: { findUnique: jest.fn(), update: jest.fn() },
            passwordResetToken: { updateMany: jest.fn(), create: jest.fn(), findUnique: jest.fn(), update: jest.fn() },
            $transaction: jest.fn((ops) => Promise.all(ops)),
        };
        mailService = { sendEmail: jest.fn() };
        service = new PasswordService(prisma, mailService);
    });

    afterEach(() => {
        jest.useRealTimers();
    });

    describe('forgotPassword', () => {
        it('returns the generic message without creating a token when the user does not exist', async () => {
            prisma.user.findUnique.mockResolvedValue(null);

            const result = await service.forgotPassword({ email: 'a@b.com' });

            expect(result).toEqual({ message: 'If an account with that email exists, a password reset link has been sent.' });
            expect(prisma.passwordResetToken.create).not.toHaveBeenCalled();
        });

        it('treats a waitlist-only user (empty password) the same as no account, without creating a token', async () => {
            prisma.user.findUnique.mockResolvedValue({ id: 'u1', email: 'a@b.com', password: '' });

            await service.forgotPassword({ email: 'a@b.com' });

            expect(prisma.passwordResetToken.create).not.toHaveBeenCalled();
        });

        it('invalidates prior unused tokens and creates a new hashed token with a 1-hour expiry for a real account', async () => {
            prisma.user.findUnique.mockResolvedValue({ id: 'u1', email: 'a@b.com', password: 'hashed-password' });
            prisma.passwordResetToken.updateMany.mockResolvedValue({ count: 1 });
            prisma.passwordResetToken.create.mockResolvedValue({});
            mailService.sendEmail.mockResolvedValue(undefined);

            await service.forgotPassword({ email: 'a@b.com' });

            expect(prisma.passwordResetToken.updateMany).toHaveBeenCalledWith({
                where: { user_uuid: 'u1', used_at: null },
                data: { used_at: NOW },
            });

            const rawToken = Buffer.alloc(32, 1).toString('hex');
            expect(prisma.passwordResetToken.create).toHaveBeenCalledWith({
                data: {
                    token_hash: hashToken(rawToken),
                    user_uuid: 'u1',
                    expires_at: new Date(NOW.getTime() + 60 * 60 * 1000),
                },
            });
        });

        it('sends the reset email with the raw (unhashed) token in the reset URL, fire-and-forget', async () => {
            prisma.user.findUnique.mockResolvedValue({ id: 'u1', email: 'a@b.com', password: 'hashed-password' });
            prisma.passwordResetToken.updateMany.mockResolvedValue({ count: 0 });
            prisma.passwordResetToken.create.mockResolvedValue({});
            mailService.sendEmail.mockResolvedValue(undefined);

            const result = await service.forgotPassword({ email: 'a@b.com' });
            // forgotPassword resolves before the fire-and-forget email actually sends
            expect(result).toEqual({ message: 'If an account with that email exists, a password reset link has been sent.' });

            await flush();

            const rawToken = Buffer.alloc(32, 1).toString('hex');
            expect(mailService.sendEmail).toHaveBeenCalledWith({
                to: 'a@b.com',
                from: EmailConfig.email_addresses.alert,
                subject: EmailConfig.templates.password_reset.subject,
                template_id: EmailConfig.templates.password_reset.template_id,
                dynamic_template_data: { resetUrl: AppUrls.resetPassword(rawToken) },
            });
        });

        it('does not let a failure sending the reset email reject forgotPassword (swallowed internally)', async () => {
            prisma.user.findUnique.mockResolvedValue({ id: 'u1', email: 'a@b.com', password: 'hashed-password' });
            prisma.passwordResetToken.updateMany.mockResolvedValue({ count: 0 });
            prisma.passwordResetToken.create.mockResolvedValue({});
            mailService.sendEmail.mockRejectedValue(new Error('resend down'));

            await expect(service.forgotPassword({ email: 'a@b.com' })).resolves.toBeDefined();
            await flush();
            expect(mailService.sendEmail).toHaveBeenCalled();
        });
    });

    describe('resetPassword', () => {
        it('throws BadRequestException when the token does not exist', async () => {
            prisma.passwordResetToken.findUnique.mockResolvedValue(null);

            await expect(service.resetPassword({ token: 'abc', password: 'newpass1' })).rejects.toThrow(BadRequestException);
        });

        it('throws BadRequestException when the token was already used', async () => {
            prisma.passwordResetToken.findUnique.mockResolvedValue({
                id: 'rt1',
                user_uuid: 'u1',
                used_at: new Date(),
                expires_at: new Date(NOW.getTime() + 1000),
            });

            await expect(service.resetPassword({ token: 'abc', password: 'newpass1' })).rejects.toThrow(BadRequestException);
        });

        it('throws BadRequestException when the token has expired', async () => {
            prisma.passwordResetToken.findUnique.mockResolvedValue({
                id: 'rt1',
                user_uuid: 'u1',
                used_at: null,
                expires_at: new Date(NOW.getTime() - 1000),
            });

            await expect(service.resetPassword({ token: 'abc', password: 'newpass1' })).rejects.toThrow(BadRequestException);
        });

        it('hashes the new password and atomically updates the user, marks the token used, and invalidates other unused tokens', async () => {
            const resetToken = {
                id: 'rt1',
                user_uuid: 'u1',
                used_at: null,
                expires_at: new Date(NOW.getTime() + 1000),
            };
            prisma.passwordResetToken.findUnique.mockResolvedValue(resetToken);
            (bcrypt.hash as jest.Mock).mockResolvedValue('new-hashed-password');
            prisma.user.update.mockResolvedValue({});
            prisma.passwordResetToken.update.mockResolvedValue({});
            prisma.passwordResetToken.updateMany.mockResolvedValue({ count: 0 });

            const result = await service.resetPassword({ token: 'abc', password: 'newpass1' });

            expect(bcrypt.hash).toHaveBeenCalledWith('newpass1', 10);
            expect(prisma.user.update).toHaveBeenCalledWith({
                where: { id: 'u1' },
                data: { password: 'new-hashed-password' },
            });
            expect(prisma.passwordResetToken.update).toHaveBeenCalledWith({
                where: { id: 'rt1' },
                data: { used_at: NOW },
            });
            expect(prisma.passwordResetToken.updateMany).toHaveBeenCalledWith({
                where: { user_uuid: 'u1', used_at: null, id: { not: 'rt1' } },
                data: { used_at: NOW },
            });
            expect(prisma.$transaction).toHaveBeenCalled();
            expect(result).toEqual({ message: 'Password has been reset successfully' });
        });
    });
});
